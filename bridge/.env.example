# Put ONE real key here. .env is gitignored. Leave the other blank.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Groq free tier: 8k tokens/minute AND a per-model daily token cap (~200k for gpt-oss-120b).
# One full eval run is ~60-80k tokens. The provider paces calls and backs off on 429.
# If a run stalls with "waiting 1000+s", the daily cap is hit: switch BRIDGE_MODEL to
# openai/gpt-oss-20b (separate quota) or wait for the reset.
# BRIDGE_MODEL=openai/gpt-oss-120b
# GROQ_MIN_GAP_MS=15000        # ms between calls; 15000 avoids 429s on the free tier
# GROQ_MAX_TOKENS=2000         # counted against TPM up front, keep small

# BRIDGE_PROVIDER=mock|claude|groq   (auto: claude if ANTHROPIC key, else groq if GROQ key, else mock)
# BRIDGE_DATA=./data
# PORT=8787
